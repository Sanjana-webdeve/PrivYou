# Leave DATABASE_URL unset to use a local SQLite file (privyou.db).
# For PostgreSQL: postgresql+psycopg2://USER:PASSWORD@HOST:5432/privyou
DATABASE_URL=
SERVER_SECRET=put-a-long-random-string-here
BASE_URL=http://localhost:8000
# Leave SMTP_HOST empty in development: reset links print in the terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PrivYou <no-reply@example.com>